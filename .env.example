x# AskFile AI - Environment Configuration Example

# Maximum file upload size in Megabytes (default: 25)
MAX_FILE_SIZE_MB=25

# RAG & Chunking Parameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=4

# Embedding Model (HuggingFace Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider Configuration
# Options: 'extractive' (zero-cost built-in), 'ollama' (local), 'openai' (cloud), 'gemini' (cloud)
LLM_PROVIDER=extractive

# Local Ollama Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# External API Keys (Optional - only required if LLM_PROVIDER is set to openai or gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
